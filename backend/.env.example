# FlowSentry environment (development defaults).
# Copy to .env and adjust for your deployment. Never commit real secrets.

# --- application ---
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# --- security (generate production values: python -c "import secrets;print(secrets.token_urlsafe(32))") ---
APP_SECRET_KEY=change-me-dev-only-cursor-signing-secret
ENCRYPTION_KEY=change-me-dev-only-base64-or-hex-32-bytes
ENCRYPTION_KEY_VERSION=v1
SESSION_COOKIE_SECURE=false
REGISTRATION_MODE=setup

# --- database (PostgreSQL; system of record) ---
DATABASE_URL=postgresql://postgres@127.0.0.1:54321/flowsentry

# --- workers ---
WORKER_ENABLED=true
WORKER_EMBEDDED=true
WORKER_INTERVAL_SECONDS=1.0

# --- notification channels (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=flowsentry@localhost
SMTP_USE_TLS=true
TELEGRAM_BOT_TOKEN=
